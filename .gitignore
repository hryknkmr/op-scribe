.DS_Store
node_modules/
# No lockfile: its package@version keys read as addresses to the email check in pii-guard, which scans
# every commit. The E2E tests pin Playwright in package.json, and Playwright pins its own dependencies;
# what is given up is the lockfile's integrity hashes. See README (開発者向け) before adding a dependency.
pnpm-lock.yaml
*.log
dist/
tmp/

# 記録データ・受信サーバの保存先。実サイトの操作記録はリポジトリに入れない。
recordings/
*.opscribe.json

# 実サイトでの評価の作業場と、Playwright の出力。
local/
test-results/

# 社名・実ホスト名などの denylist。公開しない（scripts/pii-guard.patterns.local.example.txt 参照）。
scripts/pii-guard.patterns.local.txt

# 送信先・トークンを書いたローカル設定
.env
.env.*
