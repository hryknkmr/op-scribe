#!/usr/bin/env bash
# pre-push: push される範囲の identity と追加内容を検査（merge / rebase / amend 経由の混入を捕捉）。
# bash 3.2 (macOS 既定) 互換。
set -euo pipefail
GUARD="$(git rev-parse --show-toplevel)/scripts/pii-guard.sh"
[ -x "$GUARD" ] || exit 0
if [ "${PII_GUARD_SKIP:-}" = "1" ]; then
  echo "⚠ pre-push: PII_GUARD_SKIP=1 によりバイパス（CI では遮断されます）" >&2
  exit 0
fi

ZERO="0000000000000000000000000000000000000000"
fail=0
while read -r local_ref local_sha remote_ref remote_sha; do
  [ "$local_sha" = "$ZERO" ] && continue
  if [ "$remote_sha" = "$ZERO" ]; then
    revs="$(git rev-list "$local_sha" --not --remotes 2>/dev/null || true)"
    [ -z "$revs" ] && continue
    oldest="$(printf '%s\n' "$revs" | tail -1)"
    if parent="$(git rev-parse "${oldest}^" 2>/dev/null)"; then
      "$GUARD" scan-range "$parent" "$local_sha" || fail=1
    else
      "$GUARD" scan-range "$(git hash-object -t tree /dev/null)" "$local_sha" || fail=1
    fi
  else
    "$GUARD" scan-range "$remote_sha" "$local_sha" || fail=1
  fi
done

if [ "$fail" != "0" ]; then
  echo "✗ push を中止しました。push 対象に PII/社内情報または許可外 identity があります。" >&2
  exit 1
fi
